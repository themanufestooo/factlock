{
  "$defs": {
    "authorization": {
      "additionalProperties": false,
      "description": "Business authorization trail (spec \u00a73.2). Required for countersignature.",
      "properties": {
        "authorization_id": {
          "minLength": 1,
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "type": "string"
        },
        "authorized_by": {
          "enum": [
            "owner-on-file"
          ]
        },
        "method": {
          "enum": [
            "authenticated_session",
            "signed_delegation",
            "operator_approval"
          ]
        }
      },
      "required": [
        "authorization_id",
        "method",
        "authorized_at",
        "authorized_by"
      ],
      "type": "object"
    },
    "claim": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "identity"
            },
            "legal_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "address": {
              "type": "string",
              "maxLength": 500
            },
            "phone": {
              "type": "string",
              "maxLength": 40
            },
            "website": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "license"
            },
            "authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "license_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "status": {
              "enum": [
                "active",
                "inactive",
                "expired",
                "suspended"
              ]
            },
            "checked_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "authority",
            "license_number",
            "status",
            "checked_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hours"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "schedule": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": {
                "type": "object",
                "properties": {
                  "day": {
                    "enum": [
                      "mon",
                      "tue",
                      "wed",
                      "thu",
                      "fri",
                      "sat",
                      "sun"
                    ]
                  },
                  "open": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                },
                "required": [
                  "day",
                  "open",
                  "close"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "timezone",
            "schedule"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "price"
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "integer minor units"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "disclosed": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "unit": {
              "type": "string",
              "maxLength": 60
            }
          },
          "required": [
            "type",
            "item",
            "amount",
            "currency",
            "disclosed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "availability"
            },
            "service": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "available": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "service",
            "available"
          ],
          "additionalProperties": false
        }
      ]
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "key_id": {
          "minLength": 1,
          "type": "string",
          "maxLength": 200
        },
        "sig": {
          "minLength": 1,
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "type": "object"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "address": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string",
              "maxLength": 100
            },
            "postal": {
              "type": "string",
              "maxLength": 20
            },
            "state": {
              "type": "string",
              "maxLength": 100
            },
            "street": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "street",
            "city",
            "state",
            "postal"
          ],
          "type": "object"
        },
        "business_id": {
          "minLength": 1,
          "type": "string",
          "maxLength": 200
        },
        "dba": {
          "type": "string",
          "maxLength": 200
        },
        "legal_name": {
          "minLength": 1,
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "website": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "business_id",
        "legal_name"
      ],
      "type": "object"
    }
  },
  "$id": "https://factlock.example/schemas/attestation-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_id": {
      "pattern": "^fla_[A-Za-z0-9]+$",
      "type": "string",
      "maxLength": 200
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "type": "array",
      "maxItems": 64
    },
    "device_time": {
      "format": "date-time",
      "type": "string",
      "maxLength": 60
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string",
        "maxLength": 500
      },
      "type": "array",
      "maxItems": 32
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "leaf_index": {
          "minimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tree": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tree",
        "leaf_index",
        "root"
      ],
      "type": "object"
    },
    "protocol_version": {
      "const": "1.1"
    },
    "signatures": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "$ref": "#/$defs/signature"
        },
        "factlock": {
          "$ref": "#/$defs/signature"
        }
      },
      "required": [
        "business",
        "factlock"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DISPUTED",
        "CORRECTED",
        "SUSPENDED",
        "CLEARED",
        "REVOKED"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "valid_until": {
      "format": "date-time",
      "type": "string"
    },
    "verification_method": {
      "enum": [
        "field_visit",
        "document_review",
        "api_check",
        "phone_verification"
      ]
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verifier_id": {
      "minLength": 1,
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "attestation_id",
    "protocol_version",
    "status",
    "subject",
    "claims",
    "verified_at",
    "valid_until",
    "verification_method",
    "verifier_id",
    "authorization",
    "signatures"
  ],
  "title": "FactLock attestation object v1.1 (spec \u00a72)",
  "type": "object"
}
